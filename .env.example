# ──────────────────────────────────────────────────────────────────────────────
# TikTelemetry — Environment configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env, fill in your values, and run:
#   docker compose up -d
#
# EXAMPLES (uncomment one block and fill in your credentials):
#
# ── EXAMPLE 1: Grafana Cloud native (RECOMMENDED) ──────────────────────────
# Uses Prometheus remote_write for metrics + Loki JSON API for logs.
# Most efficient path into Grafana Cloud — no OTLP translation needed.
#
#   EXPORTERS=grafanacloud
#   PROMETHEUS_ENDPOINT=https://prometheus-prod-42-prod-us-east-0.grafana.net/api/prom/push
#   PROMETHEUS_USER=12345
#   PROMETHEUS_PASS=glc_your_access_policy_token
#   LOKI_ENDPOINT=https://logs-prod-012.grafana.net
#   LOKI_USER=67890
#   LOKI_PASS=glc_your_access_policy_token
#
# ── EXAMPLE 2: Grafana Cloud via OTLP ──────────────────────────────────────
# Single OTLP connection handles both metrics and logs.
# Simpler credential setup (one endpoint, one instance ID) but OTLP
# translation happens on the Grafana Cloud ingest side.
#
#   EXPORTERS=otlp
#   OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
#   OTLP_USER=12345
#   OTLP_PASS=glc_your_access_policy_token
#
# ── EXAMPLE 3: Local OpenTelemetry Collector ───────────────────────────────
# Point at any OTLP/HTTP receiver on your network (no auth).
#
#   EXPORTERS=otlp
#   OTLP_ENDPOINT=http://collector:4318
#   OTLP_INSECURE=true

# ════════════════════════════════════════════════════════════════════════════
# GENERAL
# ════════════════════════════════════════════════════════════════════════════

# Comma-separated list of exporters to enable. Multiple can run at once.
# Values:  otlp | prometheus | loki | grafanacloud (alias for prometheus,loki)
# Default: otlp
#
# Examples:
#   EXPORTERS=grafanacloud          # native Grafana Cloud (recommended)
#   EXPORTERS=otlp                   # universal OTLP
#   EXPORTERS=prometheus             # metrics only, remote_write
#   EXPORTERS=loki                   # logs only, Loki push
#   EXPORTERS=otlp,loki              # OTLP + Loki simultaneously
#EXPORTERS=otlp

# Scrape interval (Go duration format)
#POLL_INTERVAL=15s

# Service identity — becomes resource attribute / label on all telemetry
#SERVICE_NAME=tiktelemetry
#SERVICE_VERSION=dev

# Instance identifier (defaults to RouterOS address if unset)
#INSTANCE_ID=

# Agent log level: debug | info | warn | error
#LOG_LEVEL=info

# Go runtime soft memory ceiling. Recommended 24MiB on constrained devices.
#GOMEMLIMIT=24MiB

# ════════════════════════════════════════════════════════════════════════════
# ROUTER  —  MikroTik RouterOS connection (all exporters need these)
# ════════════════════════════════════════════════════════════════════════════

# RouterOS API address (REQUIRED if not default)
#ROUTER_ADDRESS=192.168.88.1:8728

# RouterOS API user
#ROUTER_USER=tiktelemetry

# RouterOS API password  ★ REQUIRED
ROUTER_PASS=CHANGE_ME

# Use API-SSL (port typically 8729)
#ROUTER_TLS=false

# Skip TLS certificate verification
#ROUTER_TLS_INSECURE=false

# Dial timeout
#ROUTER_DIAL_TIMEOUT=5s

# ════════════════════════════════════════════════════════════════════════════
# OTLP EXPORTER  —  only needed if "otlp" is in EXPORTERS
# ════════════════════════════════════════════════════════════════════════════

# Full base URL. App appends /v1/metrics and /v1/logs.
# Example: https://otlp-gateway-prod-us-east-0.grafana.net/otlp
#OTLP_ENDPOINT=

# Extra HTTP headers (comma-separated key=value)
# Example: X-Scope-OrgID=tenant1
#OTLP_HEADERS=

# Bearer token (sets Authorization: Bearer <token>)
#OTLP_BEARER_TOKEN=

# Basic auth username (Grafana Cloud: numeric instance ID)
#OTLP_USER=

# Basic auth password (Grafana Cloud: access policy token with metrics:write + logs:write)
#OTLP_PASS=

# Allow plain HTTP (no TLS) — for local/collector endpoints
#OTLP_INSECURE=false

# ════════════════════════════════════════════════════════════════════════════
# PROMETHEUS EXPORTER  —  only needed if "prometheus" is in EXPORTERS
# ════════════════════════════════════════════════════════════════════════════

# Prometheus remote_write URL
# Example: https://prometheus-prod-42-prod-us-east-0.grafana.net/api/prom/push
#PROMETHEUS_ENDPOINT=

# Basic auth username (Grafana Cloud: Metrics instance ID)
#PROMETHEUS_USER=

# Basic auth password (Grafana Cloud: access policy token with metrics:write)
#PROMETHEUS_PASS=

# Extra HTTP headers (comma-separated key=value)
#PROMETHEUS_HEADERS=

# Skip TLS certificate verification (self-hosted receivers)
#PROMETHEUS_INSECURE_SKIP_VERIFY=false

# ════════════════════════════════════════════════════════════════════════════
# LOKI EXPORTER  —  only needed if "loki" is in EXPORTERS
# ════════════════════════════════════════════════════════════════════════════

# Loki push API base URL. App appends /loki/api/v1/push; full path also accepted.
# Example: https://logs-prod-012.grafana.net
#LOKI_ENDPOINT=

# Basic auth username (Grafana Cloud: Logs instance ID)
#LOKI_USER=

# Basic auth password (Grafana Cloud: access policy token with logs:write)
#LOKI_PASS=

# Extra HTTP headers (comma-separated key=value)
#LOKI_HEADERS=

# Skip TLS certificate verification
#LOKI_INSECURE_SKIP_VERIFY=false
